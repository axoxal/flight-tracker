# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Flight Data Providers
# Kiwi.com API (Required) - Get from: https://tequila.kiwi.com/portal
KIWI_API_KEY=your-kiwi-api-key-here

# Amadeus API (Optional but recommended) - Get from: https://developers.amadeus.com
AMADEUS_API_KEY=your-amadeus-api-key-here
AMADEUS_API_SECRET=your-amadeus-api-secret-here

# Skyscanner API (Future integration)
SKYSCANNER_API_KEY=your-skyscanner-key-here

# Email Service (Optional - for price alerts)
# SendGrid - Get from: https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key-here
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Map Provider (Optional - for interactive map)
# Mapbox - Get from: https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Security
# Generate a random 32+ character string for cron job authentication
CRON_SECRET=generate-a-long-random-string-here-min-32-chars

# Optional: Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key

# Optional: Error Tracking
SENTRY_DSN=your-sentry-dsn
